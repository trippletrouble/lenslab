<UserControl x:Class="LensLab.Views.FilterGalleryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:converters="clr-namespace:LensLab.Converters"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="220">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        
        <CollectionViewSource x:Key="GroupedFilters" Source="{Binding Filters}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Filter.Category" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>

    <Grid Background="{StaticResource PanelDarkSlateBrush}">
        <!-- Loading overlay -->
        <Grid Panel.ZIndex="10" 
              Background="#B0121212" 
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <mah:ProgressRing IsActive="True" Foreground="{StaticResource AccentVintageAmberBrush}" Width="40" Height="40" Margin="0,0,0,10" />
                <TextBlock Text="Rendering Previews..." 
                           Style="{StaticResource BaseTextBlockStyle}" 
                           HorizontalAlignment="Center" 
                           Foreground="{StaticResource TextMutedGreyBrush}" />
            </StackPanel>
        </Grid>

        <!-- Main Content -->
        <DockPanel Margin="12,8,12,8">
            <TextBlock Text="Film Presets" 
                       DockPanel.Dock="Top" 
                       Style="{StaticResource TitleTextBlockStyle}" 
                       Margin="0,0,0,12" />

            <!-- Preset Sharing Actions -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                
                <Button Content="Import Preset"
                        Command="{Binding ImportPresetCommand}"
                        Padding="6,4"
                        FontSize="11" />
                        
                <Button Grid.Column="2" 
                        Content="Export Preset"
                        Command="{Binding ExportPresetCommand}"
                        IsEnabled="{Binding SelectedFilter.IsCustom, FallbackValue=False}"
                        Padding="6,4"
                        FontSize="11" />
            </Grid>

            <ListBox ItemsSource="{Binding Source={StaticResource GroupedFilters}}"
                     SelectedItem="{Binding SelectedFilter}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderSlateBrush}" 
                                        BorderThickness="0,0,0,1" 
                                        Margin="0,8,0,8" 
                                        Padding="0,0,0,4">
                                    <TextBlock Text="{Binding Name}" 
                                               FontWeight="SemiBold" 
                                               Foreground="{StaticResource AccentVintageAmberBrush}" 
                                               FontSize="11" />
                                </Border>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="0,4" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{TemplateBinding Background}" 
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="itemBorder"
                                Background="{StaticResource ControlDarkBrush}"
                                BorderBrush="{StaticResource BorderSlateBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="8"
                                Margin="0,0,0,8"
                                Cursor="Hand"
                                HorizontalAlignment="Stretch">
                            <StackPanel>
                                <!-- Processed Thumbnail -->
                                <Border CornerRadius="3" ClipToBounds="True" Height="74" Margin="0,0,0,6">
                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                </Border>
                                
                                <!-- Filter Name & Delete Button Row -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0">
                                        <!-- Filter Name -->
                                        <TextBlock Text="{Binding Filter.Name}" 
                                                   Style="{StaticResource BaseTextBlockStyle}" 
                                                   Foreground="{StaticResource TextPrimaryWhiteBrush}" 
                                                   FontWeight="SemiBold" 
                                                   FontSize="12" />
                                        
                                        <!-- Manufacturer Subtitle -->
                                        <TextBlock Text="{Binding Filter.Manufacturer, StringFormat='by {0}'}" 
                                                   Style="{StaticResource BaseTextBlockStyle}" 
                                                   Foreground="{StaticResource TextMutedGreyBrush}" 
                                                   FontSize="10" 
                                                   Margin="0,1,0,4" />
                                    </StackPanel>
                                    
                                    <!-- Delete Button (Visible only for custom presets) -->
                                    <Button Grid.Column="1"
                                            Click="DeletePreset_Click"
                                            Style="{StaticResource ModernFlatButtonStyle}"
                                            Padding="4,2" MinWidth="22" MinHeight="22" Margin="4,0,0,0"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding IsCustom, Converter={StaticResource BoolToVisibilityConverter}}"
                                            ToolTip="Delete Custom Preset">
                                        <iconPacks:PackIconMaterial Kind="DeleteOutline" Width="12" Height="12" Foreground="Red" />
                                    </Button>
                                </Grid>

                                <!-- Recommended For Tags -->
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <iconPacks:PackIconMaterial Kind="Camera" 
                                                                Width="10" 
                                                                Height="10" 
                                                                Foreground="{StaticResource AccentVintageAmberBrush}" 
                                                                VerticalAlignment="Center" 
                                                                Margin="0,0,4,0" />
                                    <TextBlock Text="{Binding Filter.RecommendedFor}" 
                                               Style="{StaticResource BaseTextBlockStyle}" 
                                               Foreground="{StaticResource AccentVintageAmberBrush}" 
                                               FontSize="9" 
                                               FontStyle="Italic" 
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="itemBorder" Property="BorderBrush" Value="{StaticResource BorderFocusBrush}" />
                                <Setter TargetName="itemBorder" Property="Background" Value="#252528" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="BorderBrush" Value="{StaticResource BorderFocusBrush}" />
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Grid>
</UserControl>
