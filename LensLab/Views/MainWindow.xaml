<mah:MetroWindow x:Class="LensLab.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:viewModels="clr-namespace:LensLab.ViewModels"
        xmlns:views="clr-namespace:LensLab.Views"
        xmlns:converters="clr-namespace:LensLab.Converters"
        mc:Ignorable="d"
        Title="LensLab" 
        MinWidth="1200" 
        MinHeight="700" 
        Height="700" 
        Width="1200"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="OnDrop"
        DragOver="OnDragOver">

    <mah:MetroWindow.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </mah:MetroWindow.Resources>


    <DockPanel>
        <!-- Top Toolbar -->
        <ToolBar DockPanel.Dock="Top">
            <Button Content="Open" Command="{Binding OpenImageCommand}" />
        </ToolBar>

        <!-- Bottom Status Bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
        </StatusBar>

        <!-- Main Content Area: 3 Columns -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="250" />
            </Grid.ColumnDefinitions>

            <!-- Left Panel (Filter Gallery Placeholder) -->
            <Grid Grid.Column="0">
                <Border BorderBrush="#33FFFFFF" BorderThickness="0,0,1,0" />
            </Grid>

            <!-- Middle Panel (Image Editor View) -->
            <views:ImageEditorView DataContext="{Binding CurrentImage.CurrentImage}" Grid.Column="1" />

            <!-- Right Panel (Adjustment sliders Placeholder) -->
            <Grid Grid.Column="2">
                <Border BorderBrush="#33FFFFFF" BorderThickness="1,0,0,0" />
            </Grid>
        </Grid>
    </DockPanel>
</mah:MetroWindow>
