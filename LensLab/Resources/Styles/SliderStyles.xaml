<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Custom Slider Thumb Template -->
    <Style x:Key="SliderThumbStyle" TargetType="Thumb">
        <Setter Property="SnapsToDevicePixels" Value="true" />
        <Setter Property="OverridesDefaultStyle" Value="true" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Width" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid>
                        <!-- Outer circle -->
                        <Ellipse x:Name="outerEllipse" 
                                 Fill="#E1E1E2" 
                                 Stroke="#3D3D40" 
                                 StrokeThickness="1" />
                        <!-- Inner amber dot -->
                        <Ellipse x:Name="innerDot" 
                                 Fill="{StaticResource AccentVintageAmberBrush}" 
                                 Width="4" 
                                 Height="4" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter TargetName="outerEllipse" Property="Fill" Value="#FFFFFF" />
                            <Setter TargetName="outerEllipse" Property="Stroke" Value="{StaticResource AccentVintageAmberBrush}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="true">
                            <Setter TargetName="outerEllipse" Property="Fill" Value="#FFFFFF" />
                            <Setter TargetName="outerEllipse" Property="Stroke" Value="{StaticResource AccentVintageAmberBrush}" />
                            <Setter TargetName="innerDot" Property="Width" Value="6" />
                            <Setter TargetName="innerDot" Property="Height" Value="6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Custom Slider Template -->
    <Style TargetType="Slider" x:Key="ModernSliderStyle">
        <Setter Property="SnapsToDevicePixels" Value="true" />
        <Setter Property="OverridesDefaultStyle" Value="true" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" MinHeight="{TemplateBinding MinHeight}" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Ticks container if Ticks are enabled -->
                        <TickBar x:Name="TopTick" 
                                 Visibility="Collapsed" 
                                 Fill="{StaticResource BorderSlateBrush}" 
                                 Height="4" 
                                 Placement="Top" 
                                 Grid.Row="0" 
                                 Margin="0,0,0,2"/>

                        <!-- Track and Thumb -->
                        <Border x:Name="TrackBackground" 
                                Grid.Row="1"
                                Height="4" 
                                CornerRadius="2" 
                                Background="{StaticResource SliderTrackBrush}" 
                                BorderThickness="0" 
                                VerticalAlignment="Center" 
                                Margin="5,0">
                            <!-- Track Background -->
                        </Border>

                        <Track x:Name="PART_Track" Grid.Row="1">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="false">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="false">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="Thumb" Style="{StaticResource SliderThumbStyle}" />
                            </Track.Thumb>
                        </Track>

                        <TickBar x:Name="BottomTick" 
                                 Visibility="Collapsed" 
                                 Fill="{StaticResource BorderSlateBrush}" 
                                 Height="4" 
                                 Placement="Bottom" 
                                 Grid.Row="2" 
                                 Margin="0,2,0,0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Show Ticks if TickPlacement is TopLeft, BottomRight or Both -->
                        <Trigger Property="TickPlacement" Value="TopLeft">
                            <Setter TargetName="TopTick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="TickPlacement" Value="BottomRight">
                            <Setter TargetName="BottomTick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="TickPlacement" Value="Both">
                            <Setter TargetName="TopTick" Property="Visibility" Value="Visible" />
                            <Setter TargetName="BottomTick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="false">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Make it the default style for all Sliders -->
    <Style TargetType="Slider" BasedOn="{StaticResource ModernSliderStyle}" />

</ResourceDictionary>
